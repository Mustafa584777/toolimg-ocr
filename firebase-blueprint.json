{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile with registration details and credits balance",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "credits": { "type": "number" },
        "creditsUsed_imageToCode": { "type": "number" },
        "creditsUsed_handwritingToText": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "credits", "createdAt"]
    },
    "Guest": {
      "title": "Guest Profile",
      "description": "Guest transient profile tracking credit balance",
      "type": "object",
      "properties": {
        "credits": { "type": "number" },
        "creditsUsed_imageToCode": { "type": "number" },
        "creditsUsed_handwritingToText": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["credits", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/guests/{guestId}": {
      "schema": "Guest",
      "description": "Guest transient tracker documents"
    }
  }
}
