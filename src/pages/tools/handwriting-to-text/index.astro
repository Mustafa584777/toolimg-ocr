    <!-- Firebase Scripts -->
    <script type="module">
      import { auth, db, app } from "/assets/firebase-config.js";
      import { signInWithPopup, GoogleAuthProvider, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
      
      const provider = new GoogleAuthProvider();
 
      window.handleLogin = async function() {
          try {
              await signInWithPopup(auth, provider);
          } catch (error) {
              if (error.code === 'auth/popup-closed-by-user' || error.code === 'auth/cancelled-popup-request') return; console.error("Login failed", error.message || error);
          }
      };
 
      window.handleLogout = async function() {
          try {
              await signOut(auth);
          } catch (error) {
              console.error("Logout failed", error.message || error);
          }
      };
 
      window.getAuthToken = async function() {
          const user = auth.currentUser;
          if (user) {
              return await user.getIdToken();
          }
          return null;
      };

      if (!localStorage.getItem('guest_id')) {
          localStorage.setItem('guest_id', 'guest_' + Math.random().toString(36).substring(2, 15) + Math.random().toString(36).substring(2, 15));
      }

      if (localStorage.getItem('guest_credits') === null) {
          localStorage.setItem('guest_credits', '5');
      }

      window.userCreditBalance = null;

      window.getCurrentCredits = function() {
          if (window.userCreditBalance !== null && !isNaN(window.userCreditBalance)) {
              return Math.max(0, parseInt(window.userCreditBalance, 10));
          }
          const guestCredits = localStorage.getItem('guest_credits');
          return Math.max(0, parseInt(guestCredits || '5', 10));
      };

      window.showLowCreditsModal = function() {
          const modal = document.getElementById('low-credits-modal');
          if (modal) modal.classList.remove('hidden');
      };

      window.closeLowCreditsModal = function() {
          const modal = document.getElementById('low-credits-modal');
          if (modal) modal.classList.add('hidden');
      };

      window.showOutOfCreditsModal = function() {
          const modal = document.getElementById('out-of-credits-modal');
          if (modal) modal.classList.remove('hidden');
      };

      window.closeOutOfCreditsModal = function() {
          const modal = document.getElementById('out-of-credits-modal');
          if (modal) modal.classList.add('hidden');
      };

      window.shareTool = function(platform) {
          const url = encodeURIComponent(window.location.origin);
          const text = encodeURIComponent("Check out ToolIMG - Free AI Image to Code & Handwriting to Text Converter!");
          
          if (platform === 'whatsapp') {
              window.open(`https://api.whatsapp.com/send?text=${text}%20${url}`, '_blank');
          } else if (platform === 'telegram') {
              window.open(`https://t.me/share/url?url=${url}&text=${text}`, '_blank');
          } else if (platform === 'facebook') {
              window.open(`https://www.facebook.com/sharer/sharer.php?u=${url}`, '_blank');
          } else if (platform === 'linkedin') {
              window.open(`https://www.linkedin.com/sharing/share-offsite/?url=${url}`, '_blank');
          } else if (platform === 'instagram') {
              navigator.clipboard.writeText(window.location.origin);
          }

          let current = parseInt(localStorage.getItem('guest_credits') || '5', 10);
          current += 5;
          localStorage.setItem('guest_credits', current.toString());
          window.userCreditBalance = current;
          if (typeof updateCreditsUI === 'function') {
              updateCreditsUI(current, true);
          }

          const tLow = document.getElementById('share-toast-low');
          const tOut = document.getElementById('share-toast-out');
          if (tLow) { tLow.classList.remove('hidden'); setTimeout(() => tLow.classList.add('hidden'), 4000); }
          if (tOut) { tOut.classList.remove('hidden'); setTimeout(() => tOut.classList.add('hidden'), 4000); }
      };

      function updateCreditsUI(credits, isGuest = false) {
          window.userCreditBalance = Math.max(0, parseInt(credits || 0, 10));
          const creditsDisplay = document.getElementById('credits-display');
          const creditsCount = document.getElementById('credits-count');
          if (creditsDisplay && creditsCount) {
              creditsDisplay.classList.remove('hidden');
              creditsDisplay.classList.add('flex');
              creditsCount.textContent = (isGuest ? 'Guest: ' : '') + credits + ' Credits';
          }
          const statsBalance = document.getElementById('stats-remaining-balance');
          if (statsBalance) {
              statsBalance.textContent = credits + ' Credits';
          }
      }

      function updateStatsUI(creditsUsedImgCode, creditsUsedHandwriting) {
          const imgCodeUsed = parseInt(creditsUsedImgCode || '0', 10);
          const handwritingUsed = parseInt(creditsUsedHandwriting || '0', 10);
          
          const maxThreshold = 10;
          const imgProgress = Math.min((imgCodeUsed / maxThreshold) * 100, 100);
          const handwritingProgress = Math.min((handwritingUsed / maxThreshold) * 100, 100);
          
          const modalImgCount = document.getElementById('stats-img-code-count');
          const modalImgProgress = document.getElementById('stats-img-code-progress');
          const modalHwCount = document.getElementById('stats-handwriting-count');
          const modalHwProgress = document.getElementById('stats-handwriting-progress');
          
          if (modalImgCount) modalImgCount.textContent = imgCodeUsed + ' Credits';
          if (modalImgProgress) modalImgProgress.style.width = imgProgress + '%';
          if (modalHwCount) modalHwCount.textContent = handwritingUsed + ' Credits';
          if (modalHwProgress) modalHwProgress.style.width = handwritingProgress + '%';
      }

      import { doc, onSnapshot, setDoc, updateDoc, increment } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

      window.consumeUserCredit = async function(toolName) {
          if (!auth.currentUser) return;
          const current = typeof window.getCurrentCredits === 'function' ? window.getCurrentCredits() : 1;
          if (current <= 0) return; // Prevent driving credits into negative!
          const toolField = toolName === 'image-to-code' ? 'creditsUsed_imageToCode' : 'creditsUsed_handwritingToText';
          const userDocRef = doc(db, 'users', auth.currentUser.uid);
          try {
              await updateDoc(userDocRef, {
                  credits: increment(-1),
                  [toolField]: increment(1)
              });
          } catch(e) {
              console.error("Failed to consume credit", e.message || e);
          }
      };

      let unsubscribeCredits = null;

      onAuthStateChanged(auth, (user) => {
          const headerAuthGuest = document.getElementById('header-auth-guest');
          const userMenu = document.getElementById('user-menu');
          const userName = document.getElementById('user-name');
          const userAvatar = document.getElementById('user-avatar');
          const userFallback = document.getElementById('user-fallback');
          const headerHistoryBtn = document.getElementById('header-history-btn');
          
          const mobileAuthGuest = document.getElementById('mobile-auth-guest');
          const mobileAuthUser = document.getElementById('mobile-auth-user');
          const mobileUserName = document.getElementById('mobile-user-name');

          const dashboardNav = document.getElementById('dashboard-nav');
          const mobileDashboardNav = document.getElementById('mobile-dashboard-nav');

          if (unsubscribeCredits) {
              unsubscribeCredits();
              unsubscribeCredits = null;
          }
          
          if (user) {
              if(headerAuthGuest) { headerAuthGuest.style.display = 'none'; headerAuthGuest.classList.add('hidden'); }
              if(userMenu) userMenu.style.display = 'flex';
              if(userName) userName.textContent = user.displayName || user.email.split('@')[0];
              if(headerHistoryBtn) headerHistoryBtn.classList.remove('hidden');

              if (userAvatar) {
                  if (user.photoURL) {
                      userAvatar.src = user.photoURL;
                      userAvatar.classList.remove('hidden');
                      if(userFallback) userFallback.classList.add('hidden');
                  } else {
                      userAvatar.classList.add('hidden');
                      if(userFallback) userFallback.classList.remove('hidden');
                  }
              }
              
              if(mobileAuthGuest) mobileAuthGuest.style.display = 'none';
              if(mobileAuthUser) mobileAuthUser.style.display = 'flex';
              if(mobileUserName) mobileUserName.textContent = user.displayName || user.email.split('@')[0];

              if(dashboardNav) dashboardNav.classList.remove('hidden');
              if(mobileDashboardNav) mobileDashboardNav.classList.remove('hidden');

              const userDocRef = doc(db, 'users', user.uid);
              unsubscribeCredits = onSnapshot(userDocRef, async (docSnap) => {
                  if (!docSnap.exists()) {
                      await setDoc(userDocRef, {
                          email: user.email,
                          displayName: user.displayName || '',
                          credits: 5,
                          creditsUsed_imageToCode: 0,
                          creditsUsed_handwritingToText: 0,
                          createdAt: new Date().toISOString()
                      });
                      updateCreditsUI(5, false);
                      updateStatsUI(0, 0);
                  } else {
                      const data = docSnap.data();
                      updateCreditsUI(data.credits || 0, false);
                      updateStatsUI(data.creditsUsed_imageToCode || 0, data.creditsUsed_handwritingToText || 0);
                  }
              }, (error) => {
                  console.error("Error listening to user credits:", error.message || error);
                  updateCreditsUI(5, false);
                  updateStatsUI(0, 0);
              });
          } else {
              if(headerAuthGuest) headerAuthGuest.style.display = 'flex';
              if(userMenu) userMenu.style.display = 'none';
              if(headerHistoryBtn) headerHistoryBtn.classList.remove('hidden');
              
              if(mobileAuthGuest) mobileAuthGuest.style.display = 'flex';
              if(mobileAuthUser) mobileAuthUser.style.display = 'none';

              if(dashboardNav) dashboardNav.classList.add('hidden');
              if(mobileDashboardNav) mobileDashboardNav.classList.add('hidden');

              let guestCredits = parseInt(localStorage.getItem('guest_credits') || '5', 10);
              updateCreditsUI(guestCredits, true);
              updateStatsUI(0, 0);

              const guestId = localStorage.getItem('guest_id') || 'guest_unknown';
              const guestDocRef = doc(db, 'guests', guestId);
              unsubscribeCredits = onSnapshot(guestDocRef, (docSnap) => {
                  if (docSnap.exists()) {
                      const data = docSnap.data();
                      updateCreditsUI(data.credits || 0, true);
                      updateStatsUI(data.creditsUsed_imageToCode || 0, data.creditsUsed_handwritingToText || 0);
                  }
              }, (error) => {
                  console.error("Error listening to guest credits:", error.message || error);
              });
          }
      });
    </script>

<script>
    function updateThemeUI(theme) {
        ['light', 'dark', 'system'].forEach(t => {
            const btn = document.getElementById('theme-' + t + '-btn');
            if (btn) {
                const check = btn.querySelector('.check-icon');
                if (check) { if (t === theme) {
                    check.classList.remove('hidden');
                    btn.classList.add('bg-slate-50', 'dark:bg-slate-800', 'text-slate-900', 'dark:text-white');
                    btn.classList.remove('text-slate-600', 'dark:text-slate-300');
                } else {
                    check.classList.add('hidden');
                    btn.classList.remove('bg-slate-50', 'dark:bg-slate-800', 'text-slate-900', 'dark:text-white');
                    btn.classList.add('text-slate-600', 'dark:text-slate-300');
                } }
            }
        });
    }

    function setTheme(theme) {
        if (theme === 'system') {
            localStorage.removeItem('theme');
            if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark'); localStorage.theme = 'light';;
            }
        } else {
            localStorage.theme = theme;
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark'); localStorage.theme = 'light';;
            }
        }
        updateThemeUI(theme);
    }
    window.setTheme = setTheme;
    window.updateThemeUI = updateThemeUI;

    let initialTheme = 'light';
    if (localStorage.theme === 'dark') {
        document.documentElement.classList.add('dark');
        initialTheme = 'dark';
    } else if (localStorage.theme === 'light') {
        document.documentElement.classList.remove('dark'); localStorage.theme = 'light';;
        initialTheme = 'light';
    } else if (!('theme' in localStorage)) {
        document.documentElement.classList.remove('dark'); localStorage.theme = 'light';;
        initialTheme = 'light';
    }

    document.addEventListener('DOMContentLoaded', () => {
        updateThemeUI(initialTheme);
        
        const themeBtn = document.getElementById('theme-btn');
        if (themeBtn) {
            themeBtn.addEventListener('click', () => {
                if (document.documentElement.classList.contains('dark')) {
                    setTheme('light');
                } else {
                    setTheme('dark');
                }
            });
        }
        
        const mobileThemeBtn = document.getElementById('theme-menu-btn');
        const themePopover = document.getElementById('theme-popover');
        if(mobileThemeBtn && themePopover) {
            mobileThemeBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                if(themePopover.classList.contains('hidden')) {
                    themePopover.classList.remove('hidden');
                    themePopover.classList.add('flex');
                } else {
                    themePopover.classList.add('hidden');
                    themePopover.classList.remove('flex');
                }
            });
            document.addEventListener('click', (e) => {
                if(!themePopover.contains(e.target) && !mobileThemeBtn.contains(e.target)) {
                    themePopover.classList.add('hidden');
                    themePopover.classList.remove('flex');
                }
            });
        }

        // Stats Modal Trigger Logic
        const creditsDisplay = document.getElementById('credits-display');
        const statsModal = document.getElementById('stats-modal');
        const statsBackdrop = document.getElementById('stats-modal-backdrop');
        const statsContent = document.getElementById('stats-modal-content');
        const statsClose = document.getElementById('stats-modal-close');

        function openStatsModal() {
            if(!statsModal) return;
            statsModal.classList.remove('hidden');
            statsModal.classList.add('flex');
            void statsModal.offsetWidth;
            statsBackdrop.classList.remove('opacity-0');
            statsBackdrop.classList.add('opacity-100');
            statsContent.classList.remove('scale-95', 'opacity-0');
            statsContent.classList.add('scale-100', 'opacity-100');
        }

        function closeStatsModal() {
            if(!statsModal) return;
            statsBackdrop.classList.remove('opacity-100');
            statsBackdrop.classList.add('opacity-0');
            statsContent.classList.remove('scale-100', 'opacity-100');
            statsContent.classList.add('scale-95', 'opacity-0');
            setTimeout(() => {
                statsModal.classList.add('hidden');
                statsModal.classList.remove('flex');
            }, 200);
        }

        window.openStatsModal = openStatsModal;
        window.closeStatsModal = closeStatsModal;

        if(creditsDisplay) creditsDisplay.addEventListener('click', openStatsModal);
        if(statsClose) statsClose.addEventListener('click', closeStatsModal);
        if(statsBackdrop) statsBackdrop.addEventListener('click', closeStatsModal);
    });
</script>

<script>
    function getApiUrl(endpoint) {
        const host = window.location.hostname;
        const isLocal = host === 'localhost' || host === '127.0.0.1' || host.includes('192.168.') || host.includes('0.0.0.0');
        const isVercel = host.includes('vercel.app');
        const isAIS = host.includes('run.app');
        if (isLocal || isVercel || isAIS) {
            return endpoint;
        }
        return 'https://toolimg-ocr.vercel.app' + endpoint;
    }

    let currentBase64 = null;
    let extractedText = null;

    window.handleFileSelect = function(event) {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = (e) => {
            const result = e.target.result;
            currentBase64 = result.split(',')[1];
            
            document.getElementById('upload-placeholder').classList.add('hidden');
            const preview = document.getElementById('image-preview');
            preview.src = result;
            preview.classList.remove('hidden');
            
            document.getElementById('image-overlay').classList.remove('hidden');
            document.getElementById('extract-btn').disabled = false;
            
            document.getElementById('empty-state').classList.remove('hidden');
            document.getElementById('text-output').classList.add('hidden');
            document.getElementById('copy-btn').classList.add('hidden');
        };
        reader.readAsDataURL(file);
    };

    window.extractText = async function() {
        if (!currentBase64) return;
        
        // Check credits BEFORE extraction - BLOCK if 0 credits
        const currentCredits = typeof window.getCurrentCredits === 'function' ? window.getCurrentCredits() : parseInt(localStorage.getItem('guest_credits') || '5', 10);
        if (currentCredits <= 0) {
            if (typeof window.showOutOfCreditsModal === 'function') {
                window.showOutOfCreditsModal();
            } else {
                alert("You have 0 credits remaining. Please buy credits to continue!");
            }
            return; // Strictly stop execution - do not generate results!
        }

        document.getElementById('empty-state').classList.add('hidden');
        document.getElementById('text-output').classList.add('hidden');
        document.getElementById('copy-btn').classList.add('hidden');
        document.getElementById('loading-state').classList.remove('hidden');
        startLoadingAnimation();
        document.getElementById('extract-btn').disabled = true;

        const payload = {
            base64Data: String(currentBase64),
            fileName: 'handwriting.png',
            mimeType: 'image/png'
        };

        try {
            const idToken = typeof window.getAuthToken === 'function' ? await window.getAuthToken() : null;
            const guestId = localStorage.getItem('guest_id') || '';
            
            const headers = {
                'Content-Type': 'application/json',
                'X-Guest-ID': guestId
            };
            if (idToken) {
                headers['Authorization'] = 'Bearer ' + idToken;
            }

            const response = await fetch(getApiUrl('/api/handwriting'), {
                method: 'POST',
                headers: headers,
                body: JSON.stringify(payload)
            });

            const data = await response.json();
            
            if (response.status === 403 || response.status === 400 || data.error) {
                throw new Error(data.error || "Request failed with status " + response.status);
            }

            // Consume credits locally or via firestore
            if (!idToken) {
                let guestCredits = parseInt(localStorage.getItem('guest_credits') || '5', 10);
                if (guestCredits > 0) {
                    guestCredits--;
                    localStorage.setItem('guest_credits', guestCredits.toString());
                    window.userCreditBalance = guestCredits;
                    if (typeof updateCreditsUI === 'function') {
                        updateCreditsUI(guestCredits, true);
                    }
                }
            } else {
                if (typeof window.consumeUserCredit === 'function') {
                    await window.consumeUserCredit('handwriting-to-text');
                }
            }

            // The transcribed text is returned in the markdownSummary field
            extractedText = data.markdownSummary || data.frameworkCode || data.htmlCode || 'No text extracted';
            
            // Populate view
            const textOutput = document.getElementById('text-output');
            textOutput.textContent = extractedText;
            textOutput.classList.remove('hidden');

            // Save to History
            if (window.ToolIMGHistory && window.ToolIMGHistory.saveHistoryItem) {
                window.ToolIMGHistory.saveHistoryItem({
                    toolId: 'handwriting-to-text',
                    toolName: 'English Handwriting OCR',
                    title: payload.fileName || 'Handwriting Document',
                    content: extractedText,
                    previewUrl: ''
                });
            }
            
            document.getElementById('copy-btn').classList.remove('hidden');
            document.getElementById('loading-state').classList.add('hidden');
            stopLoadingAnimation();

            // Post-extraction check for low (1) or zero (0) credits popup
            const remaining = typeof window.getCurrentCredits === 'function' ? window.getCurrentCredits() : 0;
            if (remaining === 1) {
                if (typeof window.showLowCreditsModal === 'function') window.showLowCreditsModal();
            } else if (remaining <= 0) {
                if (typeof window.showOutOfCreditsModal === 'function') window.showOutOfCreditsModal();
            }

        } catch (err) {
            console.error(err.message || err);
            alert("Error extracting text: " + err.message);
            document.getElementById('loading-state').classList.add('hidden');
            stopLoadingAnimation();
            document.getElementById('empty-state').classList.remove('hidden');
        } finally {
            document.getElementById('extract-btn').disabled = false;
        }
    };

    window.copyText = function() {
        if (!extractedText) return;
        navigator.clipboard.writeText(extractedText).then(() => {
            alert("Copied to clipboard!");
        });
    };


    let stageInterval;
    function startLoadingAnimation() {
        const progressBar = document.getElementById('horizontal-progress-bar');
        const badge = document.getElementById('loading-stage-badge');
        const title = document.getElementById('loading-status-title');
        
        const stage1 = document.getElementById('stage-1');
        const stage2 = document.getElementById('stage-2');
        const stage3 = document.getElementById('stage-3');
        
        const anim1 = document.getElementById('anim-stage-1');
        const anim2 = document.getElementById('anim-stage-2');
        const anim3 = document.getElementById('anim-stage-3');
        
        // Reset states
        if (progressBar) progressBar.style.width = '10%';
        if (badge) badge.textContent = 'Phase 1/3';
        if (title) title.textContent = 'Analyzing handwriting...';
        
        const resetStageClasses = (el, num) => {
            if (!el) return;
            el.className = 'flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-slate-900/40 border border-transparent text-sm font-medium text-slate-400 dark:text-slate-600 transition-all duration-300';
            el.querySelector('.stage-num').className = 'stage-num w-5 h-5 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-400 dark:text-slate-600 flex items-center justify-center text-[10px] font-bold';
            el.querySelector('.stage-num').textContent = num;
            el.querySelector('.stage-status').className = 'stage-status text-xs font-semibold';
            el.querySelector('.stage-status').textContent = 'Pending';
        };
        
        resetStageClasses(stage2, '2');
        resetStageClasses(stage3, '3');
        
        // Stage 1 active
        if (stage1) {
            stage1.className = 'flex items-center justify-between p-3 rounded-xl bg-violet-50/50 dark:bg-violet-950/20 border border-violet-100/50 dark:border-violet-900/20 text-sm font-medium text-violet-700 dark:text-violet-300 transition-all duration-300';
            stage1.querySelector('.stage-num').className = 'stage-num w-5 h-5 rounded-full bg-violet-600 text-white flex items-center justify-center text-[10px] font-bold';
            stage1.querySelector('.stage-num').textContent = '1';
            stage1.querySelector('.stage-status').className = 'stage-status text-xs font-semibold text-violet-600 dark:text-violet-400 animate-pulse';
            stage1.querySelector('.stage-status').textContent = 'Active';
        }
        
        if (anim1) { anim1.classList.remove('opacity-0', 'scale-75'); anim1.classList.add('opacity-100', 'scale-100'); }
        if (anim2) { anim2.classList.add('opacity-0', 'scale-75'); anim2.classList.remove('opacity-100', 'scale-100'); }
        if (anim3) { anim3.classList.add('opacity-0', 'scale-75'); anim3.classList.remove('opacity-100', 'scale-100'); }

        let currentStep = 0;
        
        const transitionToStep = (step) => {
            if (step === 1) {
                // Transition to stage 2
                if (progressBar) progressBar.style.width = '55%';
                if (badge) badge.textContent = 'Phase 2/3';
                if (title) title.textContent = 'Extracting handwriting layout...';
                
                // Stage 1 complete
                if (stage1) {
                    stage1.className = 'flex items-center justify-between p-3 rounded-xl bg-emerald-50/50 dark:bg-emerald-950/10 border border-emerald-100/30 dark:border-emerald-900/20 text-sm font-medium text-emerald-700 dark:text-emerald-400 transition-all duration-300';
                    stage1.querySelector('.stage-num').className = 'stage-num w-5 h-5 rounded-full bg-emerald-505 text-white flex items-center justify-center text-[10px] font-bold';
                    stage1.querySelector('.stage-num').innerHTML = '✓';
                    stage1.querySelector('.stage-status').className = 'stage-status text-xs font-semibold text-emerald-600 dark:text-emerald-400';
                    stage1.querySelector('.stage-status').textContent = 'Done';
                }
                
                // Stage 2 active
                if (stage2) {
                    stage2.className = 'flex items-center justify-between p-3 rounded-xl bg-violet-50/50 dark:bg-violet-950/20 border border-violet-100/50 dark:border-violet-900/20 text-sm font-medium text-violet-700 dark:text-violet-300 transition-all duration-300';
                    stage2.querySelector('.stage-num').className = 'stage-num w-5 h-5 rounded-full bg-violet-600 text-white flex items-center justify-center text-[10px] font-bold';
                    stage2.querySelector('.stage-status').className = 'stage-status text-xs font-semibold text-violet-600 dark:text-violet-400 animate-pulse';
                    stage2.querySelector('.stage-status').textContent = 'Active';
                }
                
                if (anim1) { anim1.classList.add('opacity-0', 'scale-75'); anim1.classList.remove('opacity-100', 'scale-100'); }
                if (anim2) { anim2.classList.remove('opacity-0', 'scale-75'); anim2.classList.add('opacity-100', 'scale-100'); }
            } else if (step === 2) {
                // Transition to stage 3
                if (progressBar) progressBar.style.width = '90%';
                if (badge) badge.textContent = 'Phase 3/3';
                if (title) title.textContent = 'Generating digitized text...';
                
                // Stage 2 complete
                if (stage2) {
                    stage2.className = 'flex items-center justify-between p-3 rounded-xl bg-emerald-50/50 dark:bg-emerald-950/10 border border-emerald-100/30 dark:border-emerald-900/20 text-sm font-medium text-emerald-700 dark:text-emerald-400 transition-all duration-300';
                    stage2.querySelector('.stage-num').className = 'stage-num w-5 h-5 rounded-full bg-emerald-505 text-white flex items-center justify-center text-[10px] font-bold';
                    stage2.querySelector('.stage-num').innerHTML = '✓';
                    stage2.querySelector('.stage-status').className = 'stage-status text-xs font-semibold text-emerald-600 dark:text-emerald-400';
                    stage2.querySelector('.stage-status').textContent = 'Done';
                }
                
                // Stage 3 active
                if (stage3) {
                    stage3.className = 'flex items-center justify-between p-3 rounded-xl bg-violet-50/50 dark:bg-violet-950/20 border border-violet-100/50 dark:border-violet-900/20 text-sm font-medium text-violet-700 dark:text-violet-300 transition-all duration-300';
                    stage3.querySelector('.stage-num').className = 'stage-num w-5 h-5 rounded-full bg-violet-600 text-white flex items-center justify-center text-[10px] font-bold';
                    stage3.querySelector('.stage-status').className = 'stage-status text-xs font-semibold text-violet-600 dark:text-violet-400 animate-pulse';
                    stage3.querySelector('.stage-status').textContent = 'Active';
                }
                
                if (anim2) { anim2.classList.add('opacity-0', 'scale-75'); anim2.classList.remove('opacity-100', 'scale-100'); }
                if (anim3) { anim3.classList.remove('opacity-0', 'scale-75'); anim3.classList.add('opacity-100', 'scale-100'); }
            }
        };
        
        stageInterval = setInterval(() => {
            currentStep++;
            if (currentStep <= 2) {
                transitionToStep(currentStep);
            }
        }, 2200);
    }
    
    function stopLoadingAnimation() {
        if (stageInterval) clearInterval(stageInterval);
        const progressBar = document.getElementById('horizontal-progress-bar');
        const badge = document.getElementById('loading-stage-badge');
        const title = document.getElementById('loading-status-title');
        
        const stage1 = document.getElementById('stage-1');
        const stage2 = document.getElementById('stage-2');
        const stage3 = document.getElementById('stage-3');
        
        const anim1 = document.getElementById('anim-stage-1');
        const anim2 = document.getElementById('anim-stage-2');
        const anim3 = document.getElementById('anim-stage-3');
        
        if (progressBar) progressBar.style.width = '100%';
        if (badge) badge.textContent = 'Completed';
        if (title) title.textContent = 'Digitization Success!';
        
        // Complete remaining stages on stop
        const markDone = (el) => {
            if (!el) return;
            el.className = 'flex items-center justify-between p-3 rounded-xl bg-emerald-50/50 dark:bg-emerald-950/10 border border-emerald-100/30 dark:border-emerald-900/20 text-sm font-medium text-emerald-700 dark:text-emerald-400 transition-all duration-300';
            el.querySelector('.stage-num').className = 'stage-num w-5 h-5 rounded-full bg-emerald-500 text-white flex items-center justify-center text-[10px] font-bold';
            el.querySelector('.stage-num').innerHTML = '✓';
            el.querySelector('.stage-status').className = 'stage-status text-xs font-semibold text-emerald-600 dark:text-emerald-400';
            el.querySelector('.stage-status').textContent = 'Done';
        };
        
        markDone(stage1);
        markDone(stage2);
        markDone(stage3);
        
        if (anim1) { anim1.classList.add('opacity-0', 'scale-75'); anim1.classList.remove('opacity-100', 'scale-100'); }
        if (anim2) { anim2.classList.add('opacity-0', 'scale-75'); anim2.classList.remove('opacity-100', 'scale-100'); }
        if (anim3) { anim3.classList.remove('opacity-0', 'scale-75'); anim3.classList.add('opacity-100', 'scale-100'); }
    }
    

</script>
