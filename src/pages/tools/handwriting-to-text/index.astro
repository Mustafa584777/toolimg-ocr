<script type="module">
    import { initHistoryUI, openHistoryDrawer, closeHistoryDrawer } from '/assets/history-ui.js';
    window.openHistoryDrawer = openHistoryDrawer;
    window.closeHistoryDrawer = closeHistoryDrawer;
    
    document.addEventListener('DOMContentLoaded', () => {
        initHistoryUI('handwriting-to-text');
    });

    window.handleLoadHistoryItem = function(item) {
        if (item && item.content) {
            extractedText = item.content;
            const textOutput = document.getElementById('text-output');
            if (textOutput) {
                textOutput.textContent = extractedText;
                textOutput.classList.remove('hidden');
            }
            const copyBtn = document.getElementById('copy-btn');
            if (copyBtn) copyBtn.classList.remove('hidden');
            const emptyState = document.getElementById('empty-state');
            if (emptyState) emptyState.classList.add('hidden');
        }
    };
</script>













