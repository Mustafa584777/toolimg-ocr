    <script>
        function getApiUrl(endpoint) {
            const host = window.location.hostname;
            const isLocal = host === 'localhost' || host === '127.0.0.1' || host.includes('192.168.') || host.includes('0.0.0.0');
            const isVercel = host.includes('vercel.app');
            const isAIS = host.includes('run.app');
            if (isLocal || isVercel || isAIS) {
                return endpoint;
            }
            return 'https://toolimg-ocr.vercel.app' + endpoint;
        }

        let currentBase64 = null;
        let generatedData = null;
        let selectedFramework = 'html-tailwind';
        window.isLoggedIn = false;

        window.selectFramework = function(fw) {
            selectedFramework = fw;
            document.querySelectorAll('.framework-pill').forEach(pill => {
                const label = pill.querySelector('.label-text');
                const iconWrapper = pill.querySelector('.framework-icon-wrapper');
                
                if (pill.getAttribute('data-framework') === fw) {
                    pill.classList.add('border-violet-600', 'dark:border-violet-400', 'bg-violet-50/50', 'dark:bg-violet-950/35', 'ring-1', 'ring-violet-500');
                    pill.classList.remove('border-transparent', 'bg-transparent', 'hover:bg-slate-50', 'dark:hover:bg-slate-800');
                    if (label) {
                        label.classList.add('text-slate-900', 'dark:text-white');
                        label.classList.remove('text-slate-500', 'dark:text-slate-400');
                    }
                    if (iconWrapper) {
                        iconWrapper.className = "framework-icon-wrapper w-8 h-8 rounded-xl bg-violet-100 dark:bg-violet-950/60 text-violet-600 dark:text-violet-400 flex items-center justify-center transition shrink-0";
                    }
                    const check = pill.querySelector('.check-badge');
                    if (check) check.classList.remove('hidden');
                } else {
                    pill.classList.remove('border-violet-600', 'dark:border-violet-400', 'bg-violet-50/50', 'dark:bg-violet-950/35', 'ring-1', 'ring-violet-500');
                    pill.classList.add('border-transparent', 'bg-transparent', 'hover:bg-slate-50', 'dark:hover:bg-slate-800');
                    if (label) {
                        label.classList.remove('text-slate-900', 'dark:text-white');
                        label.classList.add('text-slate-500', 'dark:text-slate-400');
                    }
                    if (iconWrapper) {
                        iconWrapper.className = "framework-icon-wrapper w-8 h-8 rounded-xl bg-slate-100/80 dark:bg-slate-800/50 text-slate-500 dark:text-slate-400 flex items-center justify-center transition shrink-0";
                    }
                    const check = pill.querySelector('.check-badge');
                    if (check) check.classList.add('hidden');
                }
            });
        };

        window.renderResultViews = function() {
            if (!generatedData) return;
            const htmlCode = generatedData.htmlCode || 'No HTML available';
            const codeText = generatedData.frameworkCode || htmlCode;
            const linesCount = codeText.split('\n').length;
            
            document.getElementById('preview-iframe').srcdoc = htmlCode;
            document.getElementById('code-output').textContent = codeText;
            
            const isLoggedIn = window.isLoggedIn || false;
            
            let visualOverlay = document.getElementById('visual-login-overlay');
            if (!visualOverlay) {
                visualOverlay = document.createElement('div');
                visualOverlay.id = 'visual-login-overlay';
                const vVisual = document.getElementById('view-visual');
                if (vVisual) {
                    vVisual.style.position = 'relative';
                    vVisual.appendChild(visualOverlay);
                }
            }
            
            let codeOverlay = document.getElementById('code-login-overlay');
            if (!codeOverlay) {
                codeOverlay = document.createElement('div');
                codeOverlay.id = 'code-login-overlay';
