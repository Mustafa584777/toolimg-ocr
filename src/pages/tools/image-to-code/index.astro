        window.handleFileSelect = function(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = (e) => {
                const result = e.target.result;
                currentBase64 = result.split(',')[1];
                
                document.getElementById('upload-placeholder').classList.add('hidden');
                const preview = document.getElementById('image-preview');
                preview.src = result;
                preview.classList.remove('hidden');
                
                document.getElementById('image-overlay').classList.remove('hidden');
                document.getElementById('generate-btn').disabled = false;
                
                document.getElementById('empty-state').classList.remove('hidden');
                document.getElementById('view-visual').classList.add('hidden');
                document.getElementById('view-code').classList.add('hidden');
                document.getElementById('view-design').classList.add('hidden');
            };
            reader.readAsDataURL(file);
        }

        window.generateCode = async function() {
            if (!currentBase64) return;
            
            // Check credits BEFORE generation - BLOCK if 0 credits
            const currentCredits = typeof window.getCurrentCredits === 'function' ? window.getCurrentCredits() : parseInt(localStorage.getItem('guest_credits') || '5', 10);
            if (currentCredits <= 0) {
                if (typeof window.showOutOfCreditsModal === 'function') {
                    window.showOutOfCreditsModal();
                } else {
                    alert("You have 0 credits remaining. Please buy credits to continue!");
                }
                return; // Strictly stop execution - do not generate results!
            }

            document.getElementById('empty-state').classList.add('hidden');
            document.getElementById('view-visual').classList.add('hidden');
            document.getElementById('view-code').classList.add('hidden');
            document.getElementById('view-design').classList.add('hidden');
            document.getElementById('loading-state').classList.remove('hidden'); startLoadingAnimation();
            document.getElementById('generate-btn').disabled = true;

            const payload = {
                base64Data: String(currentBase64),
                framework: String(selectedFramework || "html-tailwind"),
                styleTheme: 'match-image',
                customPrompt: String(document.getElementById("opt-prompt").value),
                interactivity: 'interactive'
            };

            try {
                const idToken = typeof window.getAuthToken === 'function' ? await window.getAuthToken() : null;
                const guestId = localStorage.getItem('guest_id') || '';
                
                const headers = {
                    'Content-Type': 'application/json',
                    'X-Guest-ID': guestId
                };
                if (idToken) {
                    headers['Authorization'] = 'Bearer ' + idToken;
                }

                const response = await fetch(getApiUrl('/api/ocr'), {
                    method: 'POST',
                    headers: headers,
                    body: JSON.stringify(payload)
                });

                const data = await response.json();
                
                if (response.status === 403 || response.status === 400 || data.error) {
                    throw new Error(data.error || "Request failed with status " + response.status);
                }

                // Consume credits locally or via firestore
                if (!idToken) {
                    let guestCredits = parseInt(localStorage.getItem('guest_credits') || '5', 10);
                    if (guestCredits > 0) {
                        guestCredits--;
                        localStorage.setItem('guest_credits', guestCredits.toString());
                        window.userCreditBalance = guestCredits;
                        if (typeof updateCreditsUI === 'function') {
                            updateCreditsUI(guestCredits, true);
                        }
                    }
                } else {
                    if (typeof window.consumeUserCredit === 'function') {
                        await window.consumeUserCredit('image-to-code');
                    }
                }

                generatedData = data;
                
                // Save to History
                if (window.ToolIMGHistory && window.ToolIMGHistory.saveHistoryItem) {
                    window.ToolIMGHistory.saveHistoryItem({
                        toolId: 'image-to-code',
                        toolName: 'Image to Code AI',
                        title: (payload.fileName || 'Image Design') + ' (' + payload.framework + ')',
                        content: data.frameworkCode || data.htmlCode || '',
                        previewUrl: ''
                    });
                }
                
                // Populate views via helper
                renderResultViews();
                
                if (data.designAnalysis) {
                    const da = data.designAnalysis;
                    document.getElementById('design-colors').innerHTML = (da.colors || []).map(c => 
                        `<div class="flex items-center gap-2 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 p-2 rounded-lg"><div class="w-6 h-6 rounded border border-slate-300 dark:border-slate-700" style="background-color: ${c}"></div><span class="font-mono text-xs text-slate-800 dark:text-slate-200">${c}</span></div>`
                    ).join('');
                    document.getElementById('design-typography').textContent = da.typography || 'N/A';
                    document.getElementById('design-layout').textContent = da.layout || 'N/A';
                    document.getElementById('design-components').innerHTML = (da.components || []).map(c => `<li>${c}</li>`).join('');
                }

                document.getElementById('loading-state').classList.add('hidden'); stopLoadingAnimation();
                switchTab('visual');

                // Post-generation check for low (1) or zero (0) credits popup
                const remaining = typeof window.getCurrentCredits === 'function' ? window.getCurrentCredits() : 0;
                if (remaining === 1) {
                    if (typeof window.showLowCreditsModal === 'function') window.showLowCreditsModal();
                } else if (remaining <= 0) {
                    if (typeof window.showOutOfCreditsModal === 'function') window.showOutOfCreditsModal();
                }

            } catch (err) {
                console.error(err.message || err);
                alert("Error generating code: " + err.message);
                document.getElementById('loading-state').classList.add('hidden'); stopLoadingAnimation();
                document.getElementById('empty-state').classList.remove('hidden');
            } finally {
                document.getElementById('generate-btn').disabled = false;
            }
        }

        window.switchTab = function(tabId) {
            const tabs = ['visual', 'code', 'design'];
            
            tabs.forEach(t => {
                const btn = document.getElementById(`tab-${t}`);
                const view = document.getElementById(`view-${t}`);
                
                if (t === tabId) {
                    btn.classList.add('bg-white', 'dark:bg-slate-900', 'shadow-sm', 'text-slate-900', 'dark:text-white', 'border', 'border-slate-200', 'dark:border-slate-800');
                    btn.classList.remove('text-slate-500', 'dark:text-slate-400', 'hover:bg-slate-100', 'dark:hover:bg-slate-800');
                    view.classList.remove('hidden');
                } else {
                    btn.classList.remove('bg-white', 'dark:bg-slate-900', 'shadow-sm', 'text-slate-900', 'dark:text-white', 'border', 'border-slate-200', 'dark:border-slate-800');
                    btn.classList.add('text-slate-500', 'dark:text-slate-400', 'hover:bg-slate-100', 'dark:hover:bg-slate-800');
                    view.classList.add('hidden');
                }
            });
        }

        window.copyGeneratedCode = function() {
            if (!generatedData) return;
            const text = generatedData.frameworkCode || generatedData.htmlCode;
            navigator.clipboard.writeText(text).then(() => {
                alert("Copied to clipboard!");
            });
        }
    </script>

