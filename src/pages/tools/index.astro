    <!-- Firebase Scripts -->
    <script type="module">
      import { auth, db, app } from "/assets/firebase-config.js";
      import { signInWithPopup, GoogleAuthProvider, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
      import { doc, getDoc, setDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";
      
      const provider = new GoogleAuthProvider();

      window.handleLogin = async function() {
          try {
              await signInWithPopup(auth, provider);
          } catch (error) {
              if (error.code === 'auth/popup-closed-by-user' || error.code === 'auth/cancelled-popup-request') {
                  console.log('User closed the login popup.');
                  return;
              }
              if (error.code === 'auth/popup-closed-by-user' || error.code === 'auth/cancelled-popup-request') return; console.error("Login failed", error.message || String(error));
          }
      };

      window.handleLogout = async function() {
          try {
              await signOut(auth);
          } catch (error) {
              console.error("Logout failed", error.message || String(error));
          }
      };

      if (localStorage.getItem('guest_credits') === null) {
          localStorage.setItem('guest_credits', '5');
      }
      if (!localStorage.getItem('guest_id')) {
          localStorage.setItem('guest_id', 'guest_' + Math.random().toString(36).substring(2, 15) + Math.random().toString(36).substring(2, 15));
      }

      function updateCreditsUI(credits, isGuest = false) {
          const creditsDisplay = document.getElementById('credits-display');
          const creditsCount = document.getElementById('credits-count');
          if (creditsDisplay && creditsCount) {
              creditsDisplay.classList.remove('hidden');
              creditsDisplay.classList.add('flex');
              creditsCount.textContent = (isGuest ? 'Guest: ' : '') + credits + ' Credits';
          }
          const statsBalance = document.getElementById('stats-remaining-balance');
          if (statsBalance) {
              statsBalance.textContent = credits + ' Credits';
          }
      }

      function updateStatsUI(creditsUsedImgCode, creditsUsedHandwriting) {
          const imgCodeUsed = parseInt(creditsUsedImgCode || '0', 10);
          const handwritingUsed = parseInt(creditsUsedHandwriting || '0', 10);
          
          const maxThreshold = 10;
          const imgProgress = Math.min((imgCodeUsed / maxThreshold) * 100, 100);
          const handwritingProgress = Math.min((handwritingUsed / maxThreshold) * 100, 100);
          
          const modalImgCount = document.getElementById('stats-img-code-count');
          const modalImgProgress = document.getElementById('stats-img-code-progress');
          const modalHwCount = document.getElementById('stats-handwriting-count');
          const modalHwProgress = document.getElementById('stats-handwriting-progress');
          
          if (modalImgCount) modalImgCount.textContent = imgCodeUsed + ' Credits';
          if (modalImgProgress) modalImgProgress.style.width = imgProgress + '%';
          if (modalHwCount) modalHwCount.textContent = handwritingUsed + ' Credits';
          if (modalHwProgress) modalHwProgress.style.width = handwritingProgress + '%';
      }

      let unsubscribeCredits = null;

      if (auth) {
          onAuthStateChanged(auth, (user) => {
          const headerAuthGuest = document.getElementById('header-auth-guest');
          const userMenu = document.getElementById('user-menu');
          const userName = document.getElementById('user-name');
          const userAvatar = document.getElementById('user-avatar');
          const userFallback = document.getElementById('user-fallback');
          const headerHistoryBtn = document.getElementById('header-history-btn');

          const mobileAuthGuest = document.getElementById('mobile-auth-guest');
          const mobileAuthUser = document.getElementById('mobile-auth-user');

          const dashboardNav = document.getElementById('dashboard-nav');
          const mobileDashboardNav = document.getElementById('mobile-dashboard-nav');

          if (unsubscribeCredits) {
              unsubscribeCredits();
              unsubscribeCredits = null;
          }

          if (user) {
              if(headerAuthGuest) { headerAuthGuest.style.display = 'none'; headerAuthGuest.classList.add('hidden'); }
              if(userMenu) userMenu.style.display = 'flex';
              if(userName) userName.textContent = user.displayName || user.email.split('@')[0];

              if (userAvatar) {
                  if (user.photoURL) {
                      userAvatar.src = user.photoURL;
                      userAvatar.classList.remove('hidden');
                      if(userFallback) userFallback.classList.add('hidden');
                  } else {
                      userAvatar.classList.add('hidden');
                      if(userFallback) userFallback.classList.remove('hidden');
                  }
              }
              
              if(mobileAuthGuest) mobileAuthGuest.style.display = 'none';
              if(mobileAuthUser) mobileAuthUser.style.display = 'flex';

              if(dashboardNav) dashboardNav.classList.remove('hidden');
              if(mobileDashboardNav) mobileDashboardNav.classList.remove('hidden');

              const userDocRef = doc(db, 'users', user.uid);
              unsubscribeCredits = onSnapshot(userDocRef, async (docSnap) => {
                  if (!docSnap.exists()) {
                      await setDoc(userDocRef, {
                          email: user.email,
                          displayName: user.displayName || '',
                          credits: 5,
                          creditsUsed_imageToCode: 0,
                          creditsUsed_handwritingToText: 0,
                          createdAt: new Date().toISOString()
                      });
                      updateCreditsUI(5, false);
                      updateStatsUI(0, 0);
                  } else {
                      const data = docSnap.data();
                      updateCreditsUI(data.credits || 0, false);
                      updateStatsUI(data.creditsUsed_imageToCode || 0, data.creditsUsed_handwritingToText || 0);
                  }
              }, (error) => {
                  console.error("Error listening to user credits:", error.message || String(error));
                  updateCreditsUI(5, false);
                  updateStatsUI(0, 0);
              });
          } else {
              if(headerAuthGuest) headerAuthGuest.style.display = 'flex';
              if(userMenu) userMenu.style.display = 'none';
              
              if(mobileAuthGuest) mobileAuthGuest.style.display = 'flex';
              if(mobileAuthUser) mobileAuthUser.style.display = 'none';

              if(dashboardNav) dashboardNav.classList.add('hidden');
              if(mobileDashboardNav) mobileDashboardNav.classList.add('hidden');

              let guestCredits = parseInt(localStorage.getItem('guest_credits') || '5', 10);
              updateCreditsUI(guestCredits, true);
              updateStatsUI(0, 0);

              const guestId = localStorage.getItem('guest_id') || 'guest_unknown';
              const guestDocRef = doc(db, 'guests', guestId);
              unsubscribeCredits = onSnapshot(guestDocRef, (docSnap) => {
                  if (docSnap.exists()) {
                      const data = docSnap.data();
                      updateCreditsUI(data.credits || 0, true);
                      updateStatsUI(data.creditsUsed_imageToCode || 0, data.creditsUsed_handwritingToText || 0);
                  }
              }, (error) => {
                  console.error("Error listening to guest credits:", error.message || String(error));
              });
          }
      });
  } else {
      console.warn("Firebase Auth not initialized. Running in local-only guest mode.");
      let guestCredits = parseInt(localStorage.getItem('guest_credits') || '5', 10);
      updateCreditsUI(guestCredits, true);
      updateStatsUI(0, 0);
  }
    </script>

    
<script>
    function updateThemeUI(theme) {
        ['light', 'dark', 'system'].forEach(t => {
            const btn = document.getElementById('theme-' + t + '-btn');
            if (btn) {
                const check = btn.querySelector('.check-icon');
                if (check) { if (t === theme) {
                    check.classList.remove('hidden');
                    btn.classList.add('bg-slate-50', 'dark:bg-slate-800', 'text-slate-900', 'dark:text-white');
                    btn.classList.remove('text-slate-600', 'dark:text-slate-300');
                } else {
                    check.classList.add('hidden');
                    btn.classList.remove('bg-slate-50', 'dark:bg-slate-800', 'text-slate-900', 'dark:text-white');
                    btn.classList.add('text-slate-600', 'dark:text-slate-300');
                } }
            }
        });
    }

    function setTheme(theme) {
        if (theme === 'system') {
            localStorage.removeItem('theme');
            if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark'); localStorage.theme = 'light';;
            }
        } else {
            localStorage.theme = theme;
            if (theme === 'dark') {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark'); localStorage.theme = 'light';;
            }
        }
        updateThemeUI(theme);
    }
    window.setTheme = setTheme;
    window.updateThemeUI = updateThemeUI;

    let initialTheme = 'light';
    if (localStorage.theme === 'dark') {
        document.documentElement.classList.add('dark');
        initialTheme = 'dark';
    } else if (localStorage.theme === 'light') {
        document.documentElement.classList.remove('dark'); localStorage.theme = 'light';;
        initialTheme = 'light';
    } else if (!('theme' in localStorage)) {
        document.documentElement.classList.remove('dark'); localStorage.theme = 'light';;
        initialTheme = 'light';
    }

    document.addEventListener('DOMContentLoaded', () => {
        updateThemeUI(initialTheme);
        
        const themeBtns = [document.getElementById('theme-btn'), document.getElementById('theme-btn-desktop')];
        themeBtns.forEach(btn => {
            if (btn) {
                btn.addEventListener('click', () => {
                    if (document.documentElement.classList.contains('dark')) {
                        setTheme('light');
                    } else {
                        setTheme('dark');
                    }
                });
            }
        });
        
        const mobileThemeBtn = document.getElementById('theme-menu-btn');
        const themePopover = document.getElementById('theme-popover');
        if(mobileThemeBtn && themePopover) {
            mobileThemeBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                if(themePopover.classList.contains('hidden')) {
                    themePopover.classList.remove('hidden');
                    themePopover.classList.add('flex');
                } else {
                    themePopover.classList.add('hidden');
                    themePopover.classList.remove('flex');
                }
            });
            document.addEventListener('click', (e) => {
                if(!themePopover.contains(e.target) && !mobileThemeBtn.contains(e.target)) {
                    themePopover.classList.add('hidden');
                    themePopover.classList.remove('flex');
                }
            });
        }
    });
</script>

    
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('search-input');
            const filterBtns = document.querySelectorAll('.filter-btn');
            const toolCards = document.querySelectorAll('.tool-card');
            const noResults = document.getElementById('no-results');
            
            function filterTools() {
                const query = searchInput.value.toLowerCase();
                const activeFilter = document.querySelector('.filter-btn.active').dataset.filter;
                
                let visibleCount = 0;
                
                toolCards.forEach(card => {
                    const title = card.querySelector('h3').textContent.toLowerCase();
                    const desc = card.querySelector('p').textContent.toLowerCase();
                    const category = card.dataset.category;
                    
                    const matchesSearch = title.includes(query) || desc.includes(query);
                    const matchesFilter = activeFilter === 'all' || category === activeFilter;
                    
                    if (matchesSearch && matchesFilter) {
                        card.style.display = 'block';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });
                
                if (visibleCount === 0) {
                    noResults.classList.remove('hidden');
                } else {
                    noResults.classList.add('hidden');
                }
            }
            
            searchInput.addEventListener('input', filterTools);
            
            filterBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    filterBtns.forEach(b => {
                        b.classList.remove('bg-violet-600', 'text-white', 'active');
                        b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
                    });
                    btn.classList.add('bg-violet-600', 'text-white', 'active');
                    btn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
                    filterTools();
                });
            });

            // Stats Modal Trigger Logic
            const creditsDisplay = document.getElementById('credits-display');
            const statsModal = document.getElementById('stats-modal');
            const statsBackdrop = document.getElementById('stats-modal-backdrop');
            const statsContent = document.getElementById('stats-modal-content');
            const statsClose = document.getElementById('stats-modal-close');

            function openStatsModal() {
                if(!statsModal) return;
                statsModal.classList.remove('hidden');
                statsModal.classList.add('flex');
                void statsModal.offsetWidth;
                statsBackdrop.classList.remove('opacity-0');
                statsBackdrop.classList.add('opacity-100');
                statsContent.classList.remove('scale-95', 'opacity-0');
                statsContent.classList.add('scale-100', 'opacity-100');
            }

            function closeStatsModal() {
                if(!statsModal) return;
                statsBackdrop.classList.remove('opacity-100');
                statsBackdrop.classList.add('opacity-0');
                statsContent.classList.remove('scale-100', 'opacity-100');
                statsContent.classList.add('scale-95', 'opacity-0');
                setTimeout(() => {
                    statsModal.classList.add('hidden');
                    statsModal.classList.remove('flex');
                }, 200);
            }

            if(creditsDisplay) creditsDisplay.addEventListener('click', openStatsModal);
            if(statsClose) statsClose.addEventListener('click', closeStatsModal);
            if(statsBackdrop) statsBackdrop.addEventListener('click', closeStatsModal);
        });
    </script>

