<script>
// Universal circular JSON safety polyfill to prevent platform logging and 3rd party crashes
(function() {
    const originalStringify = JSON.stringify;
    JSON.stringify = function(value, replacer, space) {
        const seen = new WeakSet();
        try {
            return originalStringify(value, function(key, val) {
                if (typeof val === 'object' && val !== null) {
                    // Check if it's a DOM element or window to avoid massive circular trees
                    if (val instanceof HTMLElement || val === window || val === document) {
                        return '[DOM Element]';
                    }
                    if (seen.has(val)) {
                        return '[Circular]';
                    }
                    seen.add(val);
                }
                if (replacer) {
                    return replacer(key, val);
                }
                return val;
            }, space);
        } catch (err) {
            return '{"error":"Circular structure handled"}';
        }
    };
})();
</script>

