            </div>

            <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between gap-2">
                <div class="flex gap-1.5 overflow-x-auto text-xs">
                    <button onclick="setHistoryFilter('this')" id="hist-tab-this" class="px-3 py-1.5 rounded-xl font-bold bg-violet-600 text-white shadow-sm transition">This Tool</button>
                    <button onclick="setHistoryFilter('all')" id="hist-tab-all" class="px-3 py-1.5 rounded-xl font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition">All Tools</button>
                </div>
                <button onclick="clearHistoryWithConfirm()" class="text-xs font-bold text-rose-500 hover:text-rose-600 transition px-2.5 py-1 hover:bg-rose-50 dark:hover:bg-rose-950/40 rounded-lg">
                    Clear All
                </button>
            </div>

            <div id="history-drawer-list" class="flex-grow overflow-y-auto p-4 space-y-3"></div>
            
        </div>
    </div>
</div>

<script type="module">
    import { initHistoryUI, openHistoryDrawer, closeHistoryDrawer } from '/assets/history-ui.js';
    import { fetchHistoryItems } from '/assets/history.js';
    import { getAuth } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";

    window.openHistoryDrawer = openHistoryDrawer;
    window.closeHistoryDrawer = closeHistoryDrawer;

    let currentDashFilter = 'all';
    let dashCachedItems = [];

    window.filterDashHistory = function(toolId) {
        currentDashFilter = toolId;
        ['all', 'img', 'ocr', 'hindi', 'html'].forEach(t => {
            const btn = document.getElementById('dash-hist-' + t);
            if (btn) {
                btn.className = 'px-3.5 py-1.5 rounded-xl font-bold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition';
            }
        });

        const activeMap = {
            'all': 'dash-hist-all',
            'image-to-code': 'dash-hist-img',
            'handwriting-to-text': 'dash-hist-ocr',
            'hindi-handwriting-to-text': 'dash-hist-hindi',
            'html-to-image': 'dash-hist-html'
        };

        const activeBtn = document.getElementById(activeMap[toolId] || 'dash-hist-all');
        if (activeBtn) {
            activeBtn.className = 'px-3.5 py-1.5 rounded-xl font-bold bg-violet-600 text-white shadow-sm transition';
        }

        renderDashboardHistoryList();
    };

    async function loadDashboardHistory() {
        try {
            dashCachedItems = await fetchHistoryItems({ toolId: 'all' });
            renderDashboardHistoryList();
        } catch (e) {
            console.error('Dashboard history load error:', e);
        }
    }

    function renderDashboardHistoryList() {
        const container = document.getElementById('dash-history-list');
        if (!container) return;

        let filtered = dashCachedItems;
        if (currentDashFilter !== 'all') {
            filtered = dashCachedItems.filter(it => it.toolId === currentDashFilter);
        }

        if (!filtered || filtered.length === 0) {
            container.innerHTML = `
                <div class="flex flex-col items-center justify-center py-10 text-center text-slate-400 space-y-2">
                    <p class="text-sm font-bold text-slate-700 dark:text-slate-300">No conversion history available</p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">Use any of our AI utilities to generate & save your conversions here.</p>
                </div>
            `;
            return;
        }

        container.innerHTML = filtered.map(item => {
            const toolBadgeColor = 
                item.toolId === 'image-to-code' ? 'bg-violet-100 text-violet-700 dark:bg-violet-900/40 dark:text-violet-300' :
                item.toolId === 'handwriting-to-text' ? 'bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300' :
                item.toolId === 'hindi-handwriting-to-text' ? 'bg-indigo-100 text-indigo-700 dark:bg-indigo-900/40 dark:text-indigo-300' :
                'bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300';

            const toolUrl = 
                item.toolId === 'image-to-code' ? '/tools/image-to-code/' :
                item.toolId === 'handwriting-to-text' ? '/tools/handwriting-to-text/' :
                item.toolId === 'hindi-handwriting-to-text' ? '/tools/hindi-handwriting-to-text/' :
                '/tools/html-to-image/';

            const formattedDate = item.createdAt ? new Date(item.createdAt).toLocaleString([], { dateStyle: 'short', timeStyle: 'short' }) : 'Recently';

            return `
                <div class="p-4 bg-slate-50 dark:bg-slate-950/70 border border-slate-200/80 dark:border-slate-800 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 group hover:border-violet-300 dark:hover:border-violet-800 transition">
                    <div class="flex-grow min-w-0">
                        <div class="flex items-center gap-2 mb-1.5">
                            <span class="text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-md ${toolBadgeColor}">
                                ${item.toolName || item.toolId}
                            </span>
                            <span class="text-[11px] text-slate-400">${formattedDate}</span>
                        </div>
                        <h4 class="text-xs font-bold text-slate-900 dark:text-white truncate">${escapeHtml(item.title || 'Result')}</h4>
                        <p class="text-[11px] text-slate-500 dark:text-slate-400 truncate font-mono mt-0.5">
                            ${escapeHtml(item.content || '')}
                        </p>
                    </div>

                    <div class="flex items-center gap-2 shrink-0">
                        <button onclick="copyHistoryContent('${item.id}')" class="px-3 py-1.5 text-xs font-bold bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-100 rounded-xl transition flex items-center gap-1.5">
                            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                            <span>Copy</span>
                        </button>
                        <a href="${toolUrl}" class="px-3 py-1.5 text-xs font-bold bg-violet-600 hover:bg-violet-700 text-white rounded-xl transition flex items-center gap-1.5">
                            <span>Open Tool</span>
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </a>
                        <button onclick="deleteHistoryItem('${item.id}')" class="p-1.5 text-slate-400 hover:text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/50 rounded-xl transition">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                        </button>
                    </div>
                </div>
            `;
        }).join('');
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }

    document.addEventListener('DOMContentLoaded', () => {
        initHistoryUI('all');
        loadDashboardHistory();

        window.addEventListener('historyUpdated', () => {
            loadDashboardHistory();
        });
    });
</script>














</body></html>